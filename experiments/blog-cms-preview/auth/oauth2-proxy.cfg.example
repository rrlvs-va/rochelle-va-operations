# OAuth2 Proxy configuration prototype for the future RVS Insights admin.
# This file contains NO secrets and is not wired to production.
# Secrets should be provided as environment variables at deployment time.

provider = "github"
redirect_url = "https://<ADMIN-HOST>/oauth2/callback"

# Only the repository owner should be allowed into the admin for now.
email_domains = ["*"]
github_users = ["rrlvs-va"]

# The real admin app must NOT remain publicly reachable at its current static URL.
# It should be served only behind oauth2-proxy through a separate private upstream.
upstreams = ["http://127.0.0.1:<ADMIN-UPSTREAM-PORT>"]

# Shared-device-conscious session settings.
cookie_name = "__Host-rvsva_admin"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_path = "/"
cookie_expire = "1h"
cookie_refresh = "15m"

skip_provider_button = true
reverse_proxy = true

# Required deployment environment variables:
# OAUTH2_PROXY_CLIENT_ID
# OAUTH2_PROXY_CLIENT_SECRET
# OAUTH2_PROXY_COOKIE_SECRET
