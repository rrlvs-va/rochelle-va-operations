# Wasmer Edge / Anybuild configuration for the contact endpoint.
load("//anybuild/tools:python.bzl", "python_build", "python_config", "python_serve")

config = python_config(
    schema = 1,
    commands = {
        "start": "uvicorn app_v7:app --host 0.0.0.0 --port $PORT",
    },
    python_framework = "fastapi",
    python_server = "uvicorn",
    asgi_application = "app_v7:app",
    python_main_file = "app_v7.py",
    python_version = "3.13",
    uv_version = "0.8.15",
)

build = python_build(config)
python_serve(config, build, name = "rvs-contact-endpoint")
